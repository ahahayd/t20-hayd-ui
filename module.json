{
  "id": "t20-hayd-ui",
  "title": "T20 Hayd UI",
  "description": "Temas modernos (Dark, Light e Dark Neon) para as fichas do Tormenta20, com a cor de cada jogador.",
  "version": "2.5.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Hayd",
      "url": "https://github.com/ahahayd"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    {
      "src": "styles/variables.css",
      "layer": "variables"
    },
    "styles/theme.css",
    "styles/theme-darkmode.css",
    "styles/theme-lightmode.css",
    "styles/ficha-hayd.css",
    "styles/ficha-ameaca.css",
    "styles/ficha-mestre.css",
    "styles/journal-layout.css"
  ],
  "languages": [
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "tormenta20",
        "type": "system",
        "compatibility": {
          "minimum": "1.5.0"
        }
      }
    ]
  },
  "url": "https://github.com/ahahayd/t20-hayd-ui",
  "manifest": "https://github.com/ahahayd/t20-hayd-ui/releases/latest/download/module.json",
  "download": "https://github.com/ahahayd/t20-hayd-ui/releases/download/v2.5.0/module.zip",
  "license": "MIT",
  "readme": "https://github.com/ahahayd/t20-hayd-ui/blob/main/README.md",
  "bugs": "https://github.com/ahahayd/t20-hayd-ui/issues"
}
