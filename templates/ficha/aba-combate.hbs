<div class="hf-aba hf-aba-combate {{#if (eq hf.aba 'combate')}}ativa{{/if}}" data-aba="combate">
	{{> "modules/t20-hayd-ui/templates/ficha/ferramentas.hbs" aba="combate"}}

	{{#if hf.desbloqueada}}
	{{!-- Modo edição: modelo da aba e categorias que aparecem (flag do ator) --}}
	<div class="hf-layout-combate">
		<div class="hf-layout-modelos" role="radiogroup" aria-label="{{localize 'T20A.Ficha.LayoutModelo'}}">
			<span class="hf-layout-rotulo">{{localize 'T20A.Ficha.LayoutModelo'}}</span>
			{{#each hf.layoutCombate.modelos as |m|}}
			<button type="button" class="hf-layout-modelo {{#if m.ativo}}ativo{{/if}}" role="radio" aria-checked="{{#if m.ativo}}true{{else}}false{{/if}}"
				data-hf-modelo-combate="{{m.id}}" data-tooltip="{{m.dica}}">{{m.rotulo}}</button>
			{{/each}}
			{{#if hf.layoutCombate.mexido}}
			<button type="button" class="hf-layout-restaurar" data-hf-acao="restaurar-layout-combate" data-tooltip="{{localize 'T20A.Ficha.LayoutRestaurarDica'}}"><i class="fa-solid fa-rotate-left"></i> {{localize 'T20A.Ficha.LayoutRestaurar'}}</button>
			{{/if}}
		</div>
		{{#each hf.layoutCombate.grupos as |g|}}
		<div class="hf-layout-grupo">
			<span class="hf-layout-rotulo">{{g.rotulo}}</span>
			{{#each g.categorias as |c|}}
			<button type="button" class="hf-layout-chip {{#if c.visivel}}ativo{{/if}}" aria-pressed="{{#if c.visivel}}true{{else}}false{{/if}}"
				data-hf-categoria-combate="{{c.id}}" data-tooltip="{{localize 'T20A.Ficha.LayoutArrastar'}}"><i class="hf-layout-alca fa-solid fa-grip-vertical"></i><i class="{{c.icone}}"></i> {{c.rotulo}}</button>
			{{/each}}
		</div>
		{{/each}}
	</div>
	{{/if}}

	{{#if hf.fixados.length}}
	<div class="hf-pinos">
		{{#each hf.fixados as |f|}}
		<div class="hf-pino" data-item-id="{{f.id}}" data-nome="{{f.nome}}" role="button" tabindex="0" data-tooltip="{{localize 'T20A.Ficha.Usar'}}" {{#if @root.hf.editavel}}draggable="true"{{/if}}>
			<div class="hf-pino-img" style="background-image: url('{{f.img}}')"></div>
			<div class="hf-pino-info">
				<span class="hf-pino-nome">{{f.nome}}</span>
				<span class="hf-pino-sub">{{#if f.detalhe}}{{f.detalhe}}{{else}}{{f.ativacao}}{{#if f.custo}} · {{f.custo}}{{/if}}{{/if}}</span>
			</div>
			{{#if (ne f.qtd null)}}<span class="hf-pino-qtd">×{{f.qtd}}</span>{{/if}}
			{{#if @root.hf.editavel}}
			<a class="hf-pino-soltar" data-hf-acao="fixar" data-tooltip="{{localize 'T20A.Ficha.Desafixar'}}"><i class="fa-solid fa-xmark"></i></a>
			{{/if}}
		</div>
		{{/each}}
	</div>
	{{/if}}

	{{#each hf.combate as |secao|}}
		{{> "modules/t20-hayd-ui/templates/ficha/secao-itens.hbs" secao=secao}}
	{{else}}
		<div class="hf-estado-vazio">
			<i class="fa-solid fa-swords"></i>
			<p>{{localize 'T20A.Ficha.CombateVazio'}}</p>
		</div>
	{{/each}}
</div>
